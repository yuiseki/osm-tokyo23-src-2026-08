# DuckDB, used to export the PostGIS tables to Parquet and to query the result.
#
# Pinned to 1.5.5. The 1.5 line is required; earlier lines misbehave here.
# DuckDB is containerised rather than taken from the host so that the version
# is part of this repository. A sandboxed install (snap, flatpak) may also be
# unable to read the working directory at all.
FROM debian:bookworm-slim

ARG DUCKDB_VERSION=1.5.5
ARG DUCKDB_SHA256=c61f21485e6e41d3a0c28ce9904ea18346309cf427b4cf9479bc3564348dc885

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL -o /tmp/duckdb.gz \
      "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-amd64.gz" \
 && echo "${DUCKDB_SHA256}  /tmp/duckdb.gz" | sha256sum -c - \
 && gunzip -c /tmp/duckdb.gz > /usr/local/bin/duckdb \
 && chmod 755 /usr/local/bin/duckdb \
 && rm /tmp/duckdb.gz \
 && apt-get purge -y curl && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Baked in so the export does not need network at run time.
RUN duckdb -c "INSTALL postgres; INSTALL spatial;"

WORKDIR /work
